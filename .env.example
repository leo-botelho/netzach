VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui
# Chave pública das notificações (a chave pública do par VAPID, começa com B).
# Precisa existir na HOSPEDAGEM na hora do build: o Vite a embute no código, e
# sem ela o botão de ativar notificações não faz nada.
VITE_VAPID_PUBLIC_KEY=sua_chave_publica_vapid
